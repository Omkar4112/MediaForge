# Copy this file to .env and adjust as needed.
# docker-compose.yml reads these to configure the postgres/backend/worker services.

# --- PostgreSQL ---
POSTGRES_USER=mediaforge
POSTGRES_PASSWORD=mediaforge
POSTGRES_DB=mediaforge_media
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
# For hosted Redis (Render, Railway, Upstash), set REDIS_URL instead:
# REDIS_URL=rediss://user:pass@host:port

# --- Worker mode ---
# On single-process hosts (Render), set to "true" so the BullMQ worker
# runs inside the HTTP server process. Leave unset for Docker Compose
# where a dedicated worker container is used.
# START_WORKER_IN_PROCESS=true

# --- Analyzer service (Python/FastAPI) ---
ANALYZER_BASE_URL=http://localhost:8000
ANALYZER_TIMEOUT_MS=60000

# --- Backend API ---
NODE_ENV=development
PORT=3000

# --- Storage ---
# Optional. If unset, defaults to <repo>/storage/uploads regardless of where
# the backend process is started from. Only set this if you want a custom path.
# STORAGE_UPLOAD_DIR=/absolute/path/to/storage/uploads

# --- Upload validation ---
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# --- Queue (BullMQ) ---
QUEUE_NAME=image-processing
QUEUE_CONCURRENCY=2
QUEUE_MAX_ATTEMPTS=3

# --- Duplicate detection ---
# Max Hamming distance (out of 256 bits for a 16x16 pHash) still considered a duplicate.
DUPLICATE_HAMMING_THRESHOLD=8

# --- Migrations (used by Docker only; leave unset for local dev) ---
# MIGRATIONS_DIR=/app/database/migrations
